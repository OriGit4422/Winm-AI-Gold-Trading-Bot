# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_NEWS_API_KEY: Required for news feed.
# Get one at https://newsapi.org/
VITE_NEWS_API_KEY=""

# Institutional Data Keys
VITE_FRED_API_KEY=""
VITE_ALPHA_VANTAGE_API_KEY=""

# --- Live Prices (Forex + Precious Metals) ---
# Crypto (BTC, ETH) and the gold PAXG proxy stream live from Binance with no
# key. To get AUTHENTIC forex (EUR/USD, GBP/JPY, USD/JPY, AUD/USD), spot gold
# (XAU/USD) and silver (XAG/USD) — plus real chart history — set ONE of these:
#
# Twelve Data (primary): metals + forex + crypto + OHLC history.
#   Free key at https://twelvedata.com/
TWELVE_DATA_API_KEY=""
#
# Finnhub (fallback): forex + metals via the OANDA feed.
#   Free key at https://finnhub.io/
FINNHUB_API_KEY=""
#
# Poll interval (ms) for the REST quote provider. Leave unset to auto-derive a
# rate-safe default from the symbol count and MARKET_CREDITS_PER_MIN (e.g. 6
# symbols at an 8 credits/min budget -> 45000ms). Set it explicitly to override:
# lower for faster refresh on paid plans, higher if you add symbols.
# MARKET_POLL_INTERVAL_MS=""
#
# Credits-per-minute budget used to size the auto default above. Twelve Data's
# free tier is ~8 credits/min and each symbol costs one credit per poll.
MARKET_CREDITS_PER_MIN="8"
